<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="300.0" style="-fx-background-color: grey;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CalculatorController">
    <children>
        <VBox prefHeight="400.0" prefWidth="300.0" spacing="10" style="-fx-padding: 15;">
            <children>
                <TextArea fx:id="display" disable="true" onKeyPressed="#handleKeyPress" prefHeight="60.0" prefWidth="300.0" styleClass="display" wrapText="false" />

                <GridPane hgap="5.0" onKeyPressed="#handleKeyPress" vgap="5.0">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                        <ColumnConstraints percentWidth="25" />
                    </columnConstraints>

                    <rowConstraints>
                        <RowConstraints vgrow="ALWAYS" />
                        <RowConstraints vgrow="ALWAYS" />
                        <RowConstraints vgrow="ALWAYS" />
                        <RowConstraints vgrow="ALWAYS" />
                        <RowConstraints vgrow="ALWAYS" />
                    </rowConstraints>

                    <children>

                        <Button fx:id="buttonDelete" onAction="#handleDelete" prefHeight="25.0" prefWidth="66.0" styleClass="topOperators" text="AC" GridPane.columnSpan="2" />
                        <Button fx:id="change" onAction="#handleChangeSign" prefHeight="25.0" prefWidth="66.0" styleClass="topOperators" text="+/-" GridPane.columnIndex="2" />
                        <Button fx:id="divide" onAction="#handleOperation" prefHeight="25.0" prefWidth="67.0" styleClass="operators" text="÷" GridPane.columnIndex="3" />

                        <Button fx:id="seven" onAction="#handleNum" prefHeight="25.0" prefWidth="67.0" styleClass="digits" text="7" GridPane.rowIndex="1" />
                        <Button fx:id="eight" onAction="#handleNum" prefHeight="25.0" prefWidth="68.0" styleClass="digits" text="8" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Button fx:id="nine" onAction="#handleNum" prefHeight="25.0" prefWidth="67.0" styleClass="digits" text="9" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Button fx:id="multiply" onAction="#handleOperation" prefHeight="25.0" prefWidth="65.0" styleClass="operators" text="×" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                        <Button fx:id="four" onAction="#handleNum" prefHeight="25.0" prefWidth="67.0" styleClass="digits" text="4" GridPane.rowIndex="2" />
                        <Button fx:id="five" onAction="#handleNum" prefHeight="25.0" prefWidth="67.0" styleClass="digits" text="5" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Button fx:id="six" onAction="#handleNum" prefHeight="25.0" prefWidth="68.0" styleClass="digits" text="6" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Button fx:id="subtract" onAction="#handleOperation" prefHeight="25.0" prefWidth="104.0" styleClass="operators" text="−" GridPane.columnIndex="3" GridPane.rowIndex="2" />

                        <Button fx:id="one" onAction="#handleNum" prefHeight="25.0" prefWidth="68.0" styleClass="digits" text="1" GridPane.rowIndex="3" />
                        <Button fx:id="two" onAction="#handleNum" prefHeight="25.0" prefWidth="67.0" styleClass="digits" text="2" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Button fx:id="three" onAction="#handleNum" prefHeight="25.0" prefWidth="75.0" styleClass="digits" text="3" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <Button fx:id="add" onAction="#handleOperation" prefHeight="25.0" prefWidth="82.0" styleClass="operators" text="+" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                        <Button fx:id="zero" onAction="#handleNum" prefHeight="25.0" prefWidth="67.0" styleClass="digits" text="0" GridPane.columnSpan="2" GridPane.rowIndex="4" />
                        <Button fx:id="comma" onAction="#handleComma" prefHeight="25.0" prefWidth="77.0" styleClass="digits" text="." GridPane.columnIndex="2" GridPane.rowIndex="4" />
                        <Button fx:id="equals" onAction="#handleEquals" prefHeight="25.0" prefWidth="88.0" styleClass="operators" text="=" GridPane.columnIndex="3" GridPane.rowIndex="4" />
                    </children>
                </GridPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
